{
  "name": "obsidian-latex-live",
  "version": "0.1.7",
  "description": "Live LaTeX compilation and PDF preview for .tex files in Obsidian, driven by the TeX installation already on the machine",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "lint:review": "eslint src",
    "test": "node scripts/run-tests.mjs",
    "test:yolo": "node scripts/yolo-contract.mjs"
  },
  "keywords": [
    "obsidian",
    "latex",
    "pdf",
    "synctex"
  ],
  "overrides": {
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.8",
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    },
    "moment": "2.31.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.5",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.8",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "^26.1.0",
    "mathjax": "3.2.2",
    "obsidian": "latest",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "dompurify": "3.4.16"
  }
}
